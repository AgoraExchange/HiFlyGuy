rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.auth.token.email == request.resource.data.username + '@accounts.hiflyguy.invalid'
        && request.resource.data.username.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update, delete, list: if false;
      match /checkoutRequests/{tier} {
        allow get: if owner(uid);
        allow create, update: if owner(uid) && tier in ['flyest','god']
          && request.resource.data.keys().hasOnly(['username','tier','requestedAt'])
          && request.resource.data.tier == tier
          && request.resource.data.username == get(/databases/$(database)/documents/profiles/$(uid)).data.username
          && request.resource.data.requestedAt == request.time;
        allow delete, list: if false;
      }
    }
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update, delete, list: if false;
    }
    match /roles/{uid} {
      allow get: if owner(uid);
      allow write, list: if false;
    }
    match /entitlements/{uid} {
      allow get: if owner(uid);
      // Only the Admin SDK / privileged operator can grant, expire or revoke access.
      allow write, list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
